+"""One-shot review request ownership: borrowed clients never become privately closeable.
+
+The real lifecycle/registry/barrier run; only SDK construction and socket shutdown are fakes.
+Real SDK/socket evidence is intentionally separate from these deterministic concurrency contracts.
+"""
+import gc
+import weakref
+import threading
+import time
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from agent import background_review as bg
+from agent.chat_completion_helpers import _RequestClientRegistry
+from run_agent import AIAgent
+
+
+class _SDK:
+    def __init__(self, *, forbidden=False):
+        self.closed, self.forbidden, self.fail_close = False, forbidden, False
+        self.close_threads = []
+
+    def is_closed(self):
+        return self.closed
+
+    def close(self):
+        self.close_threads.append(threading.get_ident())
+        if self.forbidden:
+            raise AssertionError("borrowed primary must not be hard-closed")
+        if self.fail_close:
+            raise RuntimeError("private SDK close failed")
+        self.closed = True
+
+
+def _agent(owner):
+    agent = AIAgent.__new__(AIAgent)
+    agent.provider, agent.api_mode, agent.model, agent.base_url = "custom", "chat_completions", "local-fixture", "http://127.0.0.1:1/v1"
+    agent.client, agent._client_kwargs, agent._client_lock = _SDK(forbidden=True), {"base_url": agent.base_url, "api_key": "fixture"}, threading.RLock()
+    agent._active_children, agent._active_children_lock = [], threading.Lock()
+    agent._anthropic_client = None
+    if owner is not None:
+        agent._background_review_owner = owner
+    agent.created, agent.aborted = [], []
+    agent._ensure_primary_openai_client = lambda **_: agent.client
+
+    def create(_kwargs, **_):
+        client = _SDK()
+        agent.created.append(client)
+        return client
+
+    def abort(client):
+        agent.aborted.append((client, threading.get_ident()))
+        return 1
+
+    agent._create_openai_client, agent._force_close_tcp_sockets = create, abort
+    return agent
+
+
+def _run():
+    run = bg._BackgroundReviewRun()
+    run.owns_resources = True
+    return run
+
+
+@pytest.mark.parametrize("case", ["private_idle", "private_cached", "private_overflow", "borrowed_moa", "borrowed_mock", "unknown_source", "cancelled_private", "cancelled_borrowed", "in_use_cache", "unknown_idle_cache", "close_failure", "foreign_abort", "ordinary_request"])
+def test_request_release_respects_factory_ownership(case):
+    run = None if case == "ordinary_request" else _run()
+    agent = _agent(run)
+    primary = agent.client
+    registry = _RequestClientRegistry(agent)
+    clients, threads, gates, done_events, thread_errors = [], [], [], [], []
+    try:
+        if case == "borrowed_moa" or case == "cancelled_borrowed":
+            agent.provider = "moa"
+        elif case == "borrowed_mock":
+            agent.client = primary = Mock()
+            primary.close.side_effect = AssertionError("borrowed Mock primary must not be closed")
+        if case == "unknown_source":
+            client = _SDK(forbidden=True)
+            with pytest.raises(RuntimeError):
+                registry.set_client(client)
+            registry.close_once("request_error_cleanup")
+            assert not client.close_threads and run.cleanup_errors
+            retained = weakref.ref(client)
+            del client
+            gc.collect()
+            assert retained() is not None, "failed owner lost its unknown SDK after registry cleanup"
+            assert run.request_client_private(retained(), "openai") is None
+            return
+        if case == "unknown_idle_cache":
+            client = _SDK(forbidden=True)
+            agent._request_client_cache = {"client": client, "key": {}, "in_use": False, "poisoned": False}
+            bg._release_fork_clients(agent, run)
+            assert not client.close_threads and run.cleanup_errors
+            assert agent.client is primary
+            return
+        if case == "foreign_abort":
+            entered, release, done = threading.Event(), threading.Event(), threading.Event()
+            gates.append(release); done_events.append(done)
+
+            def work():
+                try:
+                    client = registry.set_client(agent._create_request_openai_client(reason="fixture"))
+                    clients.append(client)
+                    entered.set()
+                    assert release.wait(5), "test did not release its request worker"
+                except BaseException as error:
+                    thread_errors.append(error)
+                finally:
+                    registry.close_once("request_error_cleanup")
+                    done.set()
+
+            worker = threading.Thread(target=work, name="review-owned-request-fixture")
+            threads.append(worker)
+            assert run.register_request_worker(worker, done)
+            worker.start()
+            assert entered.wait(3), "request worker failed before dispatch seam"
+            registry.close_once("interrupt_abort")
+            assert not clients[0].close_threads
+            assert agent.aborted == [(clients[0], threading.get_ident())]
+            release.set()
+            assert run.wait_request_workers()
+            assert clients[0].close_threads == [worker.ident]
+            assert not worker.is_alive() and not thread_errors
+            bg._release_fork_clients(agent, run)
+            assert not run.cleanup_errors and not primary.close_threads
+            return
+        if case.startswith("cancelled_"):
+            run.cancel()
+        client = agent._create_request_openai_client(reason="fixture")
+        clients.append(client)
+        if case.startswith("cancelled_"):
+            dispatched = []
+            with pytest.raises(InterruptedError):
+                registry.set_client(client)
+                dispatched.append(client)
+            registry.close_once("request_error_cleanup")
+            assert not dispatched
+            if case == "cancelled_private":
+                assert client.is_closed()
+            else:
+                assert not primary.close_threads and not agent.aborted
+            return
+        registry.set_client(client)
+        if case in {"borrowed_moa", "borrowed_mock"}:
+            registry.set_client(primary)
+            registry.close_once("request_error_cleanup")
+            assert client is primary
+            assert not primary.close.called if isinstance(primary, Mock) else not primary.close_threads
+            assert not agent.aborted
+            assert run.request_client_private(primary, "openai") is False
+            bg._release_fork_clients(agent, run)
+            assert not primary.close.called if isinstance(primary, Mock) else not primary.close_threads
+            assert bool(run.cleanup_errors) is (case == "borrowed_moa"), "forced MoA ownership must remain a reported unsupported scope"
+            return
+        if case == "in_use_cache":
+            bg._release_fork_clients(agent, run)
+            assert not client.close_threads and not primary.close_threads
+            assert run.cleanup_errors and agent.client is primary
+            return
+        registry.close_once("stream_request_complete")
+        assert not client.is_closed(), "clean request should remain reusable before the fork ends"
+        if case == "private_cached":
+            registry.set_client(agent._create_request_openai_client(reason="fixture"))
+            assert registry.client is client and len(agent.created) == 1
+            registry.close_once("stream_request_complete")
+        elif case == "private_overflow":
+            registry.set_client(agent._create_request_openai_client(reason="fixture"))
+            extra = agent._create_request_openai_client(reason="concurrent-fixture")
+            clients.append(extra)
+            assert extra is not client
+            extra_registry = _RequestClientRegistry(agent)
+            extra_registry.set_client(extra)
+            extra_registry.close_once("request_complete")
+            assert extra.is_closed()
+            registry.close_once("stream_request_complete")
+        elif case == "close_failure":
+            client.fail_close = True
+        if run is None:
+            agent.release_clients()
+        else:
+            assert run.wait_request_workers()
+            bg._release_fork_clients(agent, run)
+        if case == "close_failure":
+            assert not client.is_closed() and run.cleanup_errors
+        else:
+            assert all(item.is_closed() for item in clients)
+            if run is not None:
+                assert not run.cleanup_errors
+        assert not primary.close_threads
+    finally:
+        for gate in gates:
+            gate.set()
+        for thread in threads:
+            if thread.ident is not None:
+                thread.join(5)
+        assert not any(thread.is_alive() for thread in threads), "fixture left a live request worker"
+        for client in clients:
+            if isinstance(client, _SDK) and not client.forbidden:
+                client.fail_close = False
+                client.close()
+
+
+_SCOPE_CASES = [
+    ("chat", True, False, "chat_completions", "custom", True),
+    ("anthropic", True, False, "anthropic_messages", "custom", True),
+    ("moa", True, False, "chat_completions", "moa", False),
+    ("ordinary_chat", False, False, "chat_completions", "custom", False),
+    ("ordinary_anthropic", False, False, "anthropic_messages", "custom", False),
+    ("explicit_chat", True, True, "chat_completions", "custom", False),
+    ("explicit_anthropic", True, True, "anthropic_messages", "custom", False),
+    ("blocked_owner_deadline", True, False, "chat_completions", "custom", True),
+]
+
+
+@pytest.mark.parametrize("case,one_shot,explicit,api_mode,provider,owned", _SCOPE_CASES, ids=[row[0] for row in _SCOPE_CASES])
+def test_exit_ownership_is_scoped_and_waits_for_owners(case, one_shot, explicit, api_mode, provider, owned, monkeypatch):
+    parent = SimpleNamespace(_background_review_one_shot=one_shot, _background_review_lock=threading.Lock(), api_mode=api_mode, provider="custom")
+    resolved = []
+
+    def resolve(*_args, **_kwargs):
