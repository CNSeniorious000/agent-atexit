+"""Real Hermes module contracts for scoped, unambiguous MCP name repair; no model or RPC."""
+import importlib.util, json, os, socket
+from types import SimpleNamespace as NS
+from pathlib import Path
+import pytest
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    import model_tools
+    import tools.registry as regmod
+    import tools.arg_coercion as coercion
+    from tools.mcp_tool_schema import mcp_prefixed_tool_name
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    home = tmp_path / "profile"; home.mkdir()
+    config = home / "config.yaml"
+    config.write_text(json.dumps({"tools":{"tool_search":{"enabled":"on"}},"model":{"default":"fixture"}}))
+    token = set_hermes_home_override(home)
+    registry = regmod.ToolRegistry()
+    for module in (regmod, model_tools, coercion): monkeypatch.setattr(module,"registry",registry)
+    monkeypatch.setattr(model_tools,"_resolve_active_context_length",lambda:200000)
+    monkeypatch.setattr(socket.socket,"connect",lambda *a,**kw:pytest.fail("Offline contract attempted network"))
+    model_tools._clear_tool_defs_cache()
+    spec = importlib.util.spec_from_file_location("repair_candidate",os.environ.get("REPAIR_SOURCE", str(Path(__file__).resolve().parents[2] / "agent/agent_runtime_helpers.py")))
+    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
+    calls=[]; posts=[]
+    agent=NS(valid_tool_names=set(),enabled_toolsets=[],disabled_toolsets=[],log_prefix="",_invalid_tool_retries=0,_invalid_json_retries=0)
+    agent._repair_tool_call=lambda name:module.repair_tool_call(agent,name)
+    agent._uniquify_tool_call_ids=lambda calls:None
+    agent._buffer_vprint=lambda *a,**kw:None
+    agent._build_assistant_message=lambda msg,reason:{"role":"assistant","content":None,"tool_calls":[{"id":t.id,"type":"function","function":{"name":t.function.name,"arguments":t.function.arguments}} for t in msg.tool_calls]}
+    def register(server="demo",action="operation",*,exposed=True,enabled=True,always=True,check=None,scope=None,handler=None):
+        name=mcp_prefixed_tool_name(server,action); toolset="mcp-"+server
+        schema={"name":name,"description":"Fixture operation","parameters":{"type":"object","properties":{"argv":{"type":"array","items":{"type":"string"}}}}}
+        registry.register(name=name,toolset=toolset,schema=schema,handler=handler or (lambda args,**kw:calls.append((name,args,kw)) or json.dumps({"ok":True})),always_load=always,check_fn=check,scope=scope)
+        if exposed: agent.valid_tool_names.add(name)
+        if enabled and toolset not in agent.enabled_toolsets: agent.enabled_toolsets.append(toolset)
+        return name
+    monkeypatch.setattr(model_tools,"_emit_post_tool_call_hook",lambda **kw:posts.append(kw))
+    yield NS(agent=agent,repair=agent._repair_tool_call,register=register,registry=registry,calls=calls,posts=posts,config=config,home=home,module=module,model_tools=model_tools)
+    model_tools._clear_tool_defs_cache()
+    reset_hermes_home_override(token)
