diff --git a/tests/tools/test_mcp_always_load.py b/tests/tools/test_mcp_always_load.py
new file mode 100644
--- /dev/null
+++ b/tests/tools/test_mcp_always_load.py
@@ -0,0 +1,130 @@
+"""MCP disclosure hints survive live/cache registration without widening session grants."""
+import json
+from contextlib import contextmanager
+from types import SimpleNamespace
+
+from mcp.types import Tool
+import pytest
+
+
+@pytest.fixture
+def runtime(tmp_path, monkeypatch):
+    import model_tools
+    import tools.mcp_tool as core
+    import tools.registry as registry_module
+    from agent.secret_scope import is_multiplex_active, set_multiplex_active
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    registry = registry_module.ToolRegistry()
+    monkeypatch.setattr(registry_module, "registry", registry)
+    monkeypatch.setattr(model_tools, "registry", registry)
+    monkeypatch.setattr(model_tools, "_resolve_active_context_length", lambda: 200000)
+    for attr in ("_servers", "_server_scope_keys", "_server_tool_scopes", "_lazy_server_configs", "_lazy_server_tool_names", "_lazy_server_fingerprints", "_mcp_tool_server_names", "_server_trust_levels", "_tool_read_only_hints"):
+        monkeypatch.setattr(core, attr, {})
+    model_tools._clear_tool_defs_cache()
+    multiplex = is_multiplex_active()
+    set_multiplex_active(True)
+
+    @contextmanager
+    def profile(name):
+        home = tmp_path / name
+        home.mkdir(exist_ok=True)
+        config = home / "config.yaml"
+        if not config.exists(): config.write_text(json.dumps({"tools": {"tool_search": {"enabled": "on"}}, "model": {"default": "test"}}))
+        token = set_hermes_home_override(home)
+        try: yield home
+        finally: reset_hermes_home_override(token)
+
+    yield registry, profile
+    model_tools._clear_tool_defs_cache()
+    set_multiplex_active(multiplex)
+
+
+def live(registry, tools, config=None):
+    import tools.mcp_tool as core
+    from tools.mcp_tool_registration import _register_server_tools
+    from tools.mcp_tool_scope import _server_key
+    server = SimpleNamespace(name="disclosure", session=object(), _tools=tools, tool_timeout=30, initialize_result=None, _list_cache_meta={}, _registered_tool_names=[])
+    core._servers[_server_key(server.name)] = server
+    names = _register_server_tools(server.name, server, config or {})
+    return names
+
+
+def sdk(name, hint):
+    return Tool.model_validate({"name": name, "description": "A capability", "inputSchema": {"type": "object", "properties": {}}, "_meta": {"anthropic/alwaysLoad": hint, "unrelated/private": "must-not-reach-the-model"}})
+
+
+def test_live_cache_roundtrip_and_legacy_refresh_are_lossless_and_selective(runtime):
+    from tools import mcp_schema_cache as cache, mcp_tool_registration as registration
+    from tools.tool_search import ToolSearchConfig, assemble_tool_defs
+    registry, profile = runtime
+    with profile("a") as home:
+        hints = [True, False, 1, 0, "true", None]
+        names = live(registry, [sdk(f"t{n}", hint) for n, hint in enumerate(hints)])
+        raw = registry.get_definitions(set(names), quiet=True)
+        assembled = assemble_tool_defs(raw, context_length=200000, config=ToolSearchConfig.from_raw({"enabled": "on"}))
+        visible = {row["function"]["name"] for row in assembled.tool_defs}
+        assert set(names) & visible == {names[0]}
+        assert "unrelated/private" not in json.dumps(raw) and "_meta" not in json.dumps(raw) and "always_load" not in json.dumps(raw)
+        for meta in (None, [], "true", {"other/alwaysLoad": True}, {"anthropic/alwaysLoad": 1}):
+            assert not registration._always_load_hint(SimpleNamespace(meta=meta))
+        assert registration._always_load_hint(SimpleNamespace(_meta={"anthropic/alwaysLoad": True}))
+        fp = cache.config_fingerprint({})
+        entry = cache.get_cached_entry("disclosure", fp)
+        assert entry is not None and [row["always_load"] for row in entry["tools"]] == [hint is True for hint in hints]
+        assert "unrelated/private" not in json.dumps(entry)
+        for name in names: registry.deregister(name, scope=registry.current_scope_key())
+        reloaded = registration._register_from_cache_sync("disclosure", {}, entry)
+        assert set(reloaded) == set(names)
+        assert [registry.get_entry(name).always_load for name in names] == [hint is True for hint in hints]
+        cached_defs = registry.get_definitions(set(reloaded), quiet=True)
+        assert assemble_tool_defs(cached_defs, context_length=200000).tool_defs == assembled.tool_defs
+        # A legacy manifest cannot tell whether metadata was absent or discarded. Miss only
+        # its lookup, without rewriting/deleting other entries or rejecting new false hints.
+        store = json.loads(cache._cache_path().read_text())
+        legacy = {"fingerprint": "old", "tools": [{"name": "legacy", "inputSchema": {}}], "utility_tools": []}
+        store["legacy"] = legacy
+        cache._cache_path().write_text(json.dumps(store, indent=2))
+        before = cache._cache_path().read_bytes()
+        assert cache.get_cached_entry("legacy", "old") is None
+        assert cache.get_cached_entry("disclosure", fp) == entry
+        assert cache._cache_path().read_bytes() == before
+        cache.write_cache_entry("legacy", "old", tools=[{"name": "legacy", "inputSchema": {}, "always_load": False}])
+        assert cache.get_cached_entry("legacy", "old") is not None
+        assert json.loads(cache._cache_path().read_text())["disclosure"] == entry
+
+
+def test_disclosure_respects_profile_selection_explicit_defer_and_generation(runtime):
+    import model_tools
+    from tools.tool_search import ToolSearchConfig, assemble_tool_defs, dispatch_tool_describe, is_deferrable_tool_name
+    from tools.connectors.search import connections_in_scope
+    registry, profile = runtime
+    name = "mcp__disclosure__t"
+    def definitions(**kwargs): return model_tools.get_tool_definitions(enabled_toolsets=["mcp-disclosure"], quiet_mode=True, **kwargs)
+    with profile("a"):
+        live(registry, [sdk("t", True)])
+        direct = definitions()
+        assert [row["function"]["name"] for row in direct] == [name]
+        assert not connections_in_scope(direct)
+        assert not definitions(disabled_toolsets=["mcp-disclosure"])
+        raw = definitions(skip_tool_search_assembly=True)
+        override = assemble_tool_defs(raw, context_length=200000, config=ToolSearchConfig.from_raw({"enabled": "on", "defer": [name]}))
+        assert name not in {row["function"]["name"] for row in override.tool_defs}
+        assert is_deferrable_tool_name(name, frozenset({name}))
+    with profile("b"):
+        assert not definitions()
+        assert name not in json.loads(dispatch_tool_describe({"names": [name]}, current_tool_defs=[])).get("tools", {})
+        live(registry, [sdk("t", False)])
+        deferred = definitions()
+        assert name not in {row["function"]["name"] for row in deferred}
+    with profile("a"):
+        assert definitions() == direct
+        generation = registry._generation
+        live(registry, [sdk("t", False)])
+        assert registry._generation > generation
+        assert name not in {row["function"]["name"] for row in definitions()}
+        live(registry, [sdk("t", True)])
+        assert definitions() == direct
+        live(registry, [sdk("t", True)], {"tools": {"include": []}})
+        # Include/exclude filtering never gains a tool merely because it asks to be visible.
+        assert live(registry, [sdk("excluded", True)], {"tools": {"include": []}}) == []
+        assert registry.get_entry("mcp__disclosure__excluded") is None
