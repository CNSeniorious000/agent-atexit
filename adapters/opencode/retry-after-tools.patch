+for (const scenario of [
+  { state: "completed", error: { message: "read ETIMEDOUT", type: "server_error" }, result: "continue" },
+  { state: "error", error: { message: "read ETIMEDOUT", type: "server_error" }, result: "continue" },
+  { state: "running", error: { message: "read ETIMEDOUT", type: "server_error" }, result: "continue" },
+  { state: "completed", error: { message: "invalid request", type: "invalid_request_error" }, result: "stop" },
+  {
+    state: "completed",
+    error: { message: '{"type":"error","error":{"code":"context_length_exceeded"}}' },
+    result: "compact",
+  },
+] as const) {
+  const state = scenario.state
+  it.live(`session.processor handles ${scenario.error.message} with a ${state} tool`, () =>
+    provideTmpdirServer(
+      ({ dir, llm }) =>
+        Effect.gen(function* () {
+          const database = yield* Database.Service
+          const { processors, session, provider } = yield* boot()
+          const release = defer<void>()
+          const stream = reply().tool("launch", {}).item()
+          if (stream.type !== "sse") throw new Error("expected stream")
+          // Break the stream only after the processor has persisted the tool state.
+          yield* llm.push(
+            raw({
+              head: [...stream.head, ...stream.tail.slice(0, -1)],
+              wait: release.promise,
+              tail: [{ error: scenario.error }],
+            }),
+          )
+          yield* llm.text("recovered")
+
+          const chat = yield* session.create({})
+          const parent = yield* user(chat.id, "launch once")
+          const msg = yield* assistant(chat.id, parent.id, path.resolve(dir))
+          const mdl = yield* provider.getModel(ref.providerID, ref.modelID)
+          const handle = yield* processors.create({ assistantMessage: msg, sessionID: chat.id, model: mdl })
+          const executions: string[] = []
+          const input: LLM.StreamInput = {
+            user: parent,
+            sessionID: chat.id,
+            model: mdl,
+            agent: agent(),
+            system: [],
+            messages: [{ role: "user", content: "launch once" }],
+            tools: {
+              launch: tool({
+                description: "Launch a resource",
+                inputSchema: z.object({}),
+                execute: async (_, options) => {
+                  executions.push("launch")
+                  if (state === "error") throw new Error("launch failed after a side effect")
+                  if (state === "running") {
+                    await new Promise<void>((resolve) =>
+                      options.abortSignal!.addEventListener("abort", () => resolve(), { once: true }),
+                    )
+                    throw new Error("interrupted")
+                  }
+                  return { title: "Launched", output: "resource:one", metadata: {} }
+                },
+              }),
+            },
+          }
+          const run = yield* handle.process(input).pipe(Effect.forkChild)
+          yield* waitFor(
+            MessageV2.parts(msg.id).pipe(
+              Effect.map((parts) => parts.find((part) => part.type === "tool" && part.state.status === state)),
+              Effect.provideService(Database.Service, database),
+            ),
+            "tool state was not persisted",
+          )
+          release.resolve()
+          expect(yield* Fiber.join(run)).toBe(scenario.result)
+          expect(yield* llm.calls).toBe(1)
+          expect(executions).toEqual(["launch"])
+          if (scenario.result !== "continue") {
+            expect(Boolean(handle.message.error)).toBe(scenario.result === "stop")
+            return
+          }
+          expect(handle.message.error).toBeUndefined()
+
+          // Use the same history conversion as the prompt loop, then inspect the next HTTP request.
+          const stored = yield* MessageV2.get({ sessionID: chat.id, messageID: msg.id })
+          expect(stored.info.role === "assistant" && stored.info.finish).toBe("tool-calls")
+          const messages = yield* MessageV2.toModelMessagesEffect(
+            [
+              { info: parent, parts: yield* MessageV2.parts(parent.id) },
+              stored,
+            ],
+            mdl,
+          )
+          const next = yield* processors.create({
+            assistantMessage: yield* assistant(chat.id, parent.id, path.resolve(dir)),
+            sessionID: chat.id,
+            model: mdl,
+          })
+          expect(yield* next.process({ ...input, messages })).toBe("continue")
+          const requests = yield* llm.inputs
+          const history = JSON.stringify(requests[1].messages)
+          expect(history).toContain('"tool_call_id":"call_1"')
+          expect(history).toContain(
+            state === "completed"
+              ? "resource:one"
+              : state === "error"
+                ? "launch failed after a side effect"
+                : "Tool execution aborted",
+          )
+          expect(yield* llm.calls).toBe(2)
+          expect(executions).toEqual(["launch"])
+        }),
+      { config: (url) => providerCfg(url) },
+    ),
+  )
+}
