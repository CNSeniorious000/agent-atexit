{
  "description": "Bind registrations to their calling session and run them at session end.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_atexit_atexit__atexit_register|mcp__atexit__atexit_register",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\"",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\"",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
