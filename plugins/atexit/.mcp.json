{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcp_servers": {
    "atexit": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/dist/mcp.mjs"],
      "env": {
        "AGENT_ATEXIT_STATE_DIR": "${PLUGIN_DATA}/atexit"
      }
    }
  },
  "mcpServers": {
    "atexit": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/mcp.mjs"],
      "env": {
        "AGENT_ATEXIT_STATE_DIR": "${CLAUDE_PLUGIN_DATA}/atexit"
      }
    }
  }
}
