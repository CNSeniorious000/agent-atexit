{
  "name": "agent-atexit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*", "adapters/*"],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "artifacts": "bun run pack:kimi && bun run pack:npm && bun run scripts/verify-artifacts.ts",
    "check": "bun run typecheck && bun run build && bun run validate && bun test",
    "watch": "bun run scripts/watch.ts",
    "pack:kimi": "bun run build && bun run scripts/package-kimi.ts",
    "pack:npm": "bun run build && bun run scripts/package-npm.ts",
    "release:check": "bun run scripts/check-release.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@opencode-ai/plugin": "^1.18.27",
    "@types/bun": "^1.3.10",
    "fflate": "^0.8.2",
    "typescript": "^5.9.3"
  }
}
